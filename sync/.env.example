# --- LeetCode auth ---
# Log in to leetcode.com in your browser, open DevTools -> Application/Storage -> Cookies
# and copy these two values:
LEETCODE_SESSION=
LEETCODE_CSRF_TOKEN=
# Your LeetCode username (as shown in your profile URL: leetcode.com/u/<username>/)
LEETCODE_USERNAME=

# --- GitHub target ---
# Fine-grained PAT with Contents: Read and write on the target repo
GITHUB_TOKEN=
GITHUB_REPO=your-username/leetcode-solutions
GITHUB_BRANCH=main

# --- Behavior ---
# LEETCODE_SESSION cookies typically expire ~ every few weeks; you'll need to refresh it then.
POLL_INTERVAL_SECONDS=30
SUBMISSION_FETCH_LIMIT=20
COMMIT_AUTHOR_NAME=leetcode-sync-bot
COMMIT_AUTHOR_EMAIL=bot@example.com
